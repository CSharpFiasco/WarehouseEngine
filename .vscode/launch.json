{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "WarehouseEngine.Api",
            "type": "dotnet",
            "request": "launch",
            "launchSettingsProfile": "WarehouseEngine.Api",
            "launchSettingsFilePath": "${workspaceFolder}/src/WarehouseEngine.Api/Properties/launchSettings.json",
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
                "uriFormat": "%s/scalar/v1"
            }
        },
        {
            "type": "msedge",
            "request": "launch",
            "name": "WarehouseEngine.UI",
            "url": "http://127.0.0.1:4201",
            "preLaunchTask": "npm: start:vs",
            "webRoot": "${workspaceFolder}"
        }
    ],
    "compounds": [
        {
            "name": "WarehouseEngine.Api + UI",
            "configurations": [
                "WarehouseEngine.Api",
                "WarehouseEngine.UI"
            ],
            "stopAll": true
        }
    ]
}