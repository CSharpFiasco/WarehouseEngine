{
  "name": "warehouse-engine.ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --open --host=localhost --port 4201",
    "start:vs": "ng serve --host=127.0.0.1 --port 4201",
    "build": "ng build",
    "build:watch": "ng build --watch",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:watch": "ng test --watch",
    "analyze": "ng build --stats-json && webpack-bundle-analyzer dist/warehouse-engine.ui/stats.json",
    "prettify": "prettier --write \"./**/*.{js,jsx,ts,tsx,json}\"",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.2.7",
    "@angular/common": "^22.2.6",
    "@angular/compiler": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/forms": "^22.2.6",
    "@angular/material": "^22.2.7",
    "@angular/platform-browser": "^22.2.6",
    "@angular/router": "^22.2.6",
    "@ngrx/effects": "^22.0.1",
    "@ngrx/operators": "^22.0.1",
    "@ngrx/signals": "^22.0.1",
    "@ngrx/store": "^22.0.1",
    "@ngrx/store-devtools": "^22.0.1",
    "d3": "^7.9.2",
    "rxjs": "~7.8.1",
    "tslib": "^2.9.1",
    "zone.js": "^0.16.3"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.6",
    "@eslint/js": "^10.0.1",
    "@types/d3": "^7.4.3",
    "@types/jasmine": "^7.0.0",
    "@vitest/browser-playwright": "^5.1.0",
    "@web/test-runner": "^1.0.1",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.14.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jasmine-core": "^7.0.2",
    "jsdom": "^31.0.0",
    "prettier": "^3.10.1",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0",
    "webpack-bundle-analyzer": "^5.4.2"
  }
}
